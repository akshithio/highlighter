{
  "name": "highlighter",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:js && npm run build:css && npm run build:html && npm run build:katex",
    "build:js": "node scripts/build-js.mjs",
    "build:css": "tailwindcss -i src/styles/content.css -o dist/content.css && tailwindcss -i src/styles/popup.css -o dist/popup.css",
    "build:html": "node scripts/copy-popup.mjs",
    "build:katex": "node scripts/copy-katex.mjs",
    "check": "tsc --noEmit",
    "package": "sh scripts/package-extension.sh",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "^0.23.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "katex": "^0.17.0"
  }
}
